# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DASHSCOPE_API_KEY: Required for Alibaba DashScope / Qwen API calls.
# Users configure this via the Secrets panel in the AI Studio UI to enable real Alibaba Qwen models.
DASHSCOPE_API_KEY="MY_DASHSCOPE_API_KEY"

# Alibaba Cloud RDS MySQL Configuration (for database storage)
MYSQL_HOST="your-rds-host.mysql.rds.aliyuncs.com"
MYSQL_PORT="3306"
MYSQL_USER="sxk_user"
MYSQL_PASSWORD="your_password"
MYSQL_DATABASE="sxk_db"

# SESSION_SECRET: HMAC key used to sign login session tokens.
# Set a long random value in production so tokens stay valid across restarts.
# If unset, the server generates a random per-boot secret (sessions reset on restart).
SESSION_SECRET="change-me-to-a-long-random-string"

# Rate limiting (per-IP). Optional — leave unset to use the built-in defaults.
#   RATE_AI_MAX     : max AI-endpoint calls per 10 min   (default 200)
#   RATE_AUTH_MAX   : max login/register calls per 15 min (default 30)
#   RATE_API_MAX    : max total /api calls per 15 min     (default 800)
#   RATE_BOOKING_MAX: max expert bookings per hour        (default 10)
# RATE_AI_MAX="200"
# RATE_AUTH_MAX="30"
# RATE_API_MAX="800"
# RATE_BOOKING_MAX="10"

# APP_MODE: which product this process serves.
#   full   = 專案 A（深度評估 + 付費解鎖 + 商城端點全部註冊）
#   t1only = 專案 B（那些端點不註冊，路徑等同不存在）
# 認不得的值會讓程序直接起不來 —— 刻意 fail-closed。
APP_MODE="full"

# PAYWALL_DEMO_OPEN: 展示用 —— 付費牆照樣顯示，但後端閘門不執行，
# 付費牆上會多一個明確標示的略過入口（沒有這個開關，沒帳號的人會卡在
# 「请先登录后再购买」，深度評估演不下去）。
# ⚠️ 開著等於任何人都能免費拿到深度評估報告。**正式站不可開啟。**
# 只接受 1/true（不執行）或 0/false（執行）；未設定即為執行，認不得的值起不來。
# PAYWALL_DEMO_OPEN="1"

# 企業微信群機器人 webhook。沒設就沒有任何專家預約通知送出。
# WECOM_WEBHOOK_URL="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxx"

# ── 微信支付 APIv3（專案 A 的 ¥19.9 解鎖）──
# 全部設齊才會啟用；缺任何一項則訂單仍可開立但無法付款，啟動日誌會列出缺哪幾項。
# ⚠️ 商戶憑證由你本人在伺服器設定，不進版控。
#
# UNLOCK_PRICE_FEN: 單一維度解鎖價，單位「分」（1990 = ¥19.9）。預設 1990。
# UNLOCK_PRICE_FEN="1990"
#
# PAY_TRADE_TYPE: h5（預設，微信外的瀏覽器）或 jsapi（微信內建瀏覽器）。
# ⚠️ jsapi 目前會回 501 —— 下單、簽名、回調都共用了，缺的是取得 openid 的網頁授權流程。
# PAY_TRADE_TYPE="h5"
#
# WECHATPAY_APPID="wx..."                    # 已認證公眾帳號 APPID，須與商戶號完成綁定
# WECHATPAY_MCHID="1900007291"               # 商戶號
# WECHATPAY_SERIAL_NO="408B07..."            # 商戶 API 證書序列號（不是微信側的）
# WECHATPAY_PRIVATE_KEY_PATH="/etc/sxk/apiclient_key.pem"   # 商戶 API 私鑰
# WECHATPAY_APIV3_KEY="32位字母数字"          # APIv3 密鑰，必須恰為 32 bytes
# WECHATPAY_PUBLIC_KEY_PATH="/etc/sxk/wxp_pub.pem"          # 微信支付公鑰（官方推薦方案）
# WECHATPAY_PUBLIC_KEY_ID="PUB_KEY_ID_..."   # 微信支付公鑰 ID，用於比對回調的 Wechatpay-Serial
# WECHATPAY_NOTIFY_URL="https://sxkscreen.com/api/pay/wechat/notify"
#   ↑ 必須 https、公網可達、不可帶查詢參數、不可填 localhost 或內網 IP

